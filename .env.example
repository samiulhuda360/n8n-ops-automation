# Copy to .env and fill in. Never commit .env.
POSTGRES_PASSWORD=
N8N_ENCRYPTION_KEY=
WEBHOOK_URL=http://localhost:5678/

# Model access (OpenAI-compatible). Leave AI_API_KEY empty to run on the rule-based path only.
AI_API_KEY=
AI_MODEL=gemini-flash-lite-latest
# Through the caching gateway in the mock services (default), or straight to the provider:
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_BASE_URL=http://mock:8790/ai/v1
# replay = answer only from eval-cache/ai, live = also call the provider, off = no model
AI_GATEWAY_MODE=replay
# off = the rule-based path for every workflow
AI_MODE=on
